{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in *.ts|*.tsx|*.mjs|*.json|*.css) cd \"$CLAUDE_PROJECT_DIR\" && npx biome check --write \"$f\" 2>&1 | tail -15 ;; esac; exit 0"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && node packages/quality-gates/bin/quality-gates.mjs rules 2>&1 | tail -15; exit 0"
          }
        ]
      }
    ]
  }
}
