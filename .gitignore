# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# database dumps made by npm run d1:backup (they hold everyone's data)
/backups/

# misc
.DS_Store
*.pem
*.sh

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# local reference docs with secrets
ENV_REFERENCE.md
.env.vercel

# vercel
.vercel

# supabase
supabase/.temp/

# opennextjs-cloudflare build output
.open-next

# wrangler local dev
.wrangler
.dev.vars
# your own Cloudflare account and database ids (copy wrangler.example.jsonc)
wrangler.jsonc
wrangler.staging.jsonc
.staging-parked/

# typescript
*.tsbuildinfo
next-env.d.ts
/.claude/*
!/.claude/skills/
!/.claude/settings.json

# browser tests (Playwright): reports, screenshots, the separate dev build
/e2e/report/
/test-results/
/playwright-report/
/.next-e2e/

# mutation testing
.stryker-tmp/
reports/
