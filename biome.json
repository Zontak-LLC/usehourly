{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "extends": ["./packages/quality-gates/biome.preset.json"],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              "react",
              "react/**",
              ":BLANK_LINE:",
              "next/**",
              ":BLANK_LINE:",
              ":PACKAGE:",
              ":BLANK_LINE:",
              ":ALIAS:",
              ":BLANK_LINE:",
              ":PATH:"
            ]
          }
        }
      }
    }
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!.github",
      "!.husky",
      "!node_modules",
      "!.next",
      "!dist",
      "!out",
      "!src/components/ui",
      "!scripts/social/*.html",
      "!worker-configuration.d.ts"
    ]
  },
  "linter": {
    "rules": {
      "nursery": {
        "useSortedClasses": "on"
      },
      "performance": {
        "noImgElement": "warn"
      },
      "style": {
        "noHeadElement": "warn"
      },
      "suspicious": {
        "noArrayIndexKey": "warn",
        "noUnknownAtRules": "off"
      },
      "complexity": {
        "noImportantStyles": "off"
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "html": {
    "formatter": {
      "indentScriptAndStyle": false,
      "selfCloseVoidElements": "always"
    }
  },
  "overrides": [
    {
      "includes": ["bridge/**", "scripts/**", "e2e/**", "custom-worker.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": [
        "e2e/**",
        "src/app/(main)/dashboard/today/_components/today-view.tsx",
        "src/lib/invoice-pdf.ts",
        "src/server/routers/time-import.ts"
      ],
      "linter": {
        "rules": {
          "complexity": {
            "noExcessiveCognitiveComplexity": "off"
          }
        }
      }
    }
  ]
}
