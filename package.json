{
  "name": "hourly",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "homepage": "https://usehourly.app",
  "scripts": {
    "dev": "next dev -p 3028",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check",
    "check:fix": "biome check --write",
    "postinstall": "prisma generate",
    "supporters": "node scripts/update-supporters.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "NEXT_PUBLIC_APP_URL=https://usehourly.app opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "d1:migrate:local": "wrangler d1 migrations apply hourly-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply hourly-db --remote"
  },
