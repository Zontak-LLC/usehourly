{
  "name": "usehourly",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "homepage": "https://usehourly.app",
  "scripts": {
    "dev": "next dev -p 3028",
    "build": "next build",
    "start": "next start",
    "lint": "biome lint",
    "format": "biome format --write",
    "check": "biome check",
    "check:fix": "biome check --write",
    "postinstall": "prisma generate",
    "supporters": "node scripts/update-supporters.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "ci": "npm run check:rules && biome check && tsc --noEmit && npm run knip:blocking && npm run dupes && vitest run --coverage",
    "e2e": "playwright test",
    "e2e:sweep": "SWEEP=1 playwright test e2e/every-control.spec.ts --project=desktop",
    "e2e:watch": "playwright test --headed --project=desktop --workers=1",
    "e2e:phone": "playwright test --project=phone",
    "e2e:desktop": "playwright test --project=desktop",
    "e2e:report": "playwright show-report e2e/report/html",
    "e2e:summary": "node e2e/summarize.mjs",
    "shots": "node scripts/shots.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "smoke:prod": "E2E_BASE_URL=https://usehourly.app playwright test e2e/smoke --project=desktop --project=phone",
    "staging:migrate": "wrangler d1 migrations apply DB --remote --config wrangler.staging.jsonc",
    "staging:deploy": "node scripts/staging-deploy.mjs",
    "staging:smoke": "node scripts/staging-smoke.mjs",
    "stress:seed": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/stress/ts-hook.mjs scripts/stress/seed.mjs",
    "stress:cleanup-staging": "node scripts/stress/recreate-staging.mjs",
    "measure:speed": "node scripts/measure-speed.mjs",
    "measure:bundle": "node scripts/bundle-size.mjs",
    "perf-check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/stress/ts-hook.mjs scripts/perf-check.mjs",
    "d1:migrate:local": "wrangler d1 migrations apply DB --local",
    "d1:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "d1:backup": "mkdir -p backups && wrangler d1 export hourly-db --remote --output=backups/hourly-$(date +%F).sql",
    "mcp:catalog": "UPDATE_MCP_CATALOG=1 vitest run src/__tests__/mcp-bridge.test.ts",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "knip": "knip",
    "check:rules": "node packages/quality-gates/bin/quality-gates.mjs rules && npm run check:colours",
    "check:colours": "node packages/quality-gates/bin/quality-gates.mjs colours",
    "dupes": "jscpd --config packages/quality-gates/jscpd.json --ignore \"**/__tests__/**,**/components/ui/**\" src packages",
    "knip:blocking": "knip --include files,dependencies,unlisted --no-progress",
    "prepare": "git config core.hooksPath .githooks || true",
    "mutation": "stryker run"
  },
  "dependencies": {
    "@prisma/adapter-d1": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@tanstack/react-query": "^5.104.3",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "@trpc/server": "^11.0.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "exceljs": "^4.4.0",
    "ical.js": "^2.2.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.9",
    "jszip": "^3.10.2",
    "lucide-react": "^1.58.0",
    "next": "16.4.2",
    "next-auth": "^5.0.0-beta.30",
    "next-themes": "^0.4.6",
    "prisma": "^7.4.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.5.15",
    "@opennextjs/cloudflare": "^1.20.12",
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/typescript-checker": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "jscpd": "^5.4.1",
    "knip": "^6.42.0",
    "postcss": "^8.5.30",
    "shadcn": "^4.21.5",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  }
}
