generator client {
  provider = "prisma-client-js"
  runtime  = "cloudflare"
}

datasource db {
  provider = "sqlite"
}

model AuthUser {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  password_hash String
  hourly_rate   Int       @default(0) // cents; default rate for new projects
  // Business details printed on invoices.
  business_name String?
  ein           String?   // normalized NN-NNNNNNN
  address       String?   // multi-line
  logo          String?   // data URL (png/jpeg), resized client-side
  payment_instructions String? // free text printed on invoices (ACH, check...)
  token_version Int      @default(0) // bump to sign out every device (see lib/session-version.ts)
  email_verified_at DateTime? // set when the address was confirmed through an emailed link
  // Demo accounts are made on the "Try the demo" button, filled with sample data, and deleted after a day
  // unless the visitor turns them into a real account (account.claimDemo).
  is_demo       Boolean   @default(false)
  // Print "Made with UseHourly" on new invoices. On by default; a toggle on the Account page turns it off.
  invoice_branding Boolean @default(true)
  // Weekly "log your hours" email (opt-in; needs a confirmed email address and the email service).
  weekly_reminder Boolean @default(false)
  timezone      String?   // IANA name from the browser, e.g. America/New_York; says when "Friday afternoon" is
  reminder_sent_week String? // the week (e.g. 2026-W42) the last reminder went out, so each week sends once
  // The GitHub account this one signs in with ("Sign in with GitHub"); null for password-only accounts.
  github_id     String?   @unique
  // The Google account ("sub") this one signs in with; null when not linked.
  google_id     String?   @unique
  created_at    DateTime  @default(now())

  clients  Client[]
  projects Project[]
  entries  TimeEntry[]
  invoices Invoice[]
  invoice_logos InvoiceLogo[]
  email_tokens EmailToken[]
  api_tokens ApiToken[]
  oauth_codes OauthCode[]

  @@index([is_demo, created_at])
  @@map("auth_users")
}

model Client {
  id         String   @id @default(uuid())
  user_id    String
  name       String
  color      String   @default("#6366f1")
  // Printed in the invoice header's "bill to" block.
  legal_name String?  // full name / company legal name; falls back to `name`
  address    String?  // multi-line
  logo       String?  // data URL (png/jpeg), resized client-side
  archived   Boolean  @default(false)
  created_at DateTime @default(now())

  user     AuthUser  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  projects Project[]
  invoices Invoice[]

  @@unique([user_id, name])
  @@map("clients")
}

model Project {
  id          String   @id @default(uuid())
  user_id     String
  client_id   String
  name        String
  hourly_rate Int      @default(0) // cents
  billable    Boolean  @default(true)
  logo        String?  // small data URL (png/jpeg), resized client-side; served via project.logos
  archived    Boolean  @default(false)
  created_at  DateTime @default(now())

  user    AuthUser    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  client  Client      @relation(fields: [client_id], references: [id], onDelete: Cascade)
  entries TimeEntry[]

  @@unique([client_id, name])
  @@index([user_id])
  @@map("projects")
}

// Duration is integer minutes. `date` is a local YYYY-MM-DD string so a
// freelancer's "Tuesday" never shifts with UTC offsets. A running timer is a
// row with started_at set (and minutes holding the already-accumulated time).
model TimeEntry {
  id         String    @id @default(uuid())
  user_id    String
  project_id String
  date       String
  minutes    Int       @default(0)
  note       String    @default("")
  started_at DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  user    AuthUser @relation(fields: [user_id], references: [id], onDelete: Cascade)
  project Project  @relation(fields: [project_id], references: [id], onDelete: Cascade)

  @@index([user_id, date])
  @@index([user_id, started_at])
  @@map("time_entries")
}

// An issued invoice. `snapshot` is a frozen JSON copy of everything printed on the PDF
// (seller details, lines, per-entry detail), so editing the account, rates or entries later
// never rewrites history; the PDF is regenerated from it on demand. `search_text` is a
// denormalized lowercase blob (number, client, projects, notes) for history search.
model Invoice {
  id            String   @id @default(uuid())
  user_id       String
  client_id     String?
  client_name   String
  number        String
  issue_date    String
  due_date      String?
  // Date the money arrived (YYYY-MM-DD), or null while unpaid. A date, not a flag: cash-basis
  // taxes depend on which year/quarter the payment landed in. Not part of the frozen snapshot.
  paid_date     String?
  period_from   String
  period_to     String
  total_minutes Int
  total_cents   Int
  notes         String   @default("")
  snapshot      String
  search_text   String
  created_at    DateTime @default(now())

  user   AuthUser @relation(fields: [user_id], references: [id], onDelete: Cascade)
  client Client?  @relation(fields: [client_id], references: [id], onDelete: SetNull)

  @@unique([user_id, number])
  @@index([user_id, issue_date])
  @@index([user_id, paid_date])
  @@map("invoices")
}

// A business or client logo as printed on an invoice, stored once per distinct image. Invoice snapshots
// point at it by hash instead of each carrying its own copy (up to 400 KB per logo per invoice).
model InvoiceLogo {
  id         String   @id @default(uuid())
  user_id    String
  hash       String // sha-256 of `data`
  data       String // png/jpeg data URL
  created_at DateTime @default(now())

  user AuthUser @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, hash])
  @@map("invoice_logos")
}

// Fixed-window counters used to throttle sign-in and register. `reset_at` is epoch seconds.
model RateLimit {
  key      String @id
  count    Int    @default(0)
  reset_at Int

  @@map("rate_limits")
}

// A one-time emailed link. `kind` is "verify" or "reset"; only the SHA-256 of the token is kept.
model EmailToken {
  id         String   @id @default(uuid())
  user_id    String
  kind       String
  token_hash String   @unique
  expires_at Int // epoch seconds
  used_at    Int? // epoch seconds, null until used
  created_at DateTime @default(now())

  user AuthUser @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, kind])
  @@map("email_tokens")
}

// A personal access token for the MCP server (/api/mcp). Only the SHA-256 of the secret is kept,
// so a database leak cannot be turned into working tokens. `prefix` is the first characters of the
// token, shown in the list so people can tell their tokens apart. `access` is "read" or "write".
// `token_version` is the account's value when the token was made: a password change or "Log out on
// all devices" bumps the account's number and so kills every token made before it.
model ApiToken {
  id            String    @id @default(uuid())
  user_id       String
  name          String
  token_hash    String    @unique
  prefix        String
  access        String    @default("write")
  token_version Int       @default(0)
  expires_at    Int? // epoch seconds, null = never
  last_used_at  Int? // epoch seconds
  revoked_at    Int? // epoch seconds, null until revoked
  created_at    DateTime  @default(now())

  user AuthUser @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@map("api_tokens")
}

/// An MCP client (Claude, Cursor, Smithery...) that registered itself to ask for access through OAuth.
model OauthClient {
  id            String   @id @default(uuid()) // the OAuth client_id
  name          String
  redirect_uris String // JSON array of the exact addresses it may be sent back to
  created_at    DateTime @default(now())

  codes OauthCode[]

  @@map("oauth_clients")
}

/// A one-time authorization code: made when the user approves, traded for an access token within minutes.
model OauthCode {
  id             String  @id @default(uuid())
  code_hash      String  @unique // SHA-256; the code itself is never stored
  client_id      String
  user_id        String
  redirect_uri   String
  code_challenge String // PKCE S256 challenge
  access         String // "read" | "write", chosen on the consent screen
  expires_at     Int // epoch seconds
  used_at        Int? // set when traded (or burned by a failed attempt)
  token_id       String? // the ApiToken it produced, so a replayed code can revoke it
  created_at     DateTime @default(now())

  user   AuthUser    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  client OauthClient @relation(fields: [client_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@map("oauth_codes")
}
