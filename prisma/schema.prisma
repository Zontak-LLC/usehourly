generator client {
  provider = "prisma-client-js"
  runtime  = "cloudflare"
}

datasource db {
  provider = "sqlite"
}

model AuthUser {
  id            String    @id @default(uuid())
  name          String?
  email         String    @unique
  password_hash String
  hourly_rate   Int       @default(0) // cents; default rate for new projects
  // Business details printed on invoices.
  business_name String?
  ein           String?   // normalized NN-NNNNNNN
  address       String?   // multi-line
  logo          String?   // data URL (png/jpeg), resized client-side
  payment_instructions String? // free text printed on invoices (ACH, check...)
  // Tax added to invoices (issue #71 step 4, lib/tax.ts): name ("VAT"), rate in basis points (2000 = 20%; null/0 = none)
  // and the seller's tax number (VAT/GST registration), printed on invoices.
  tax_name      String?
  tax_rate      Int?
  tax_number    String?
  token_version Int      @default(0) // bump to sign out every device (see lib/session-version.ts)
  email_verified_at DateTime? // set when the address was confirmed through an emailed link
  email_bounced_at DateTime? // set when the address bounced for good or reported spam; no more reminder mail
  // Demo accounts are made on the "Try the demo" button, filled with sample data, and deleted after a day
  // unless the visitor turns them into a real account (account.claimDemo).
  is_demo       Boolean   @default(false)
  // Print "Made with UseHourly" on new invoices. On by default; a toggle on the Account page turns it off.
  invoice_branding Boolean @default(true)
  // Weekly "log your hours" email (opt-in; needs a confirmed email address and the email service).
  weekly_reminder Boolean @default(false)
  // Light/dark mode (theme_mode) is saved so it follows the account to other devices; null = never chosen.
  // theme_preset is no longer read or written (colour presets were removed 2026-10-22); the column stays so the migration is additive.
  theme_preset  String?
  currency      String    @default("USD") // ISO 4217, one per account (lib/money.ts); locked once an invoice exists
  theme_mode    String?
  // The person's picture for the top bar: a small png/jpeg data URL (resized in the browser), null = initials.
  avatar        String?
  timezone      String?   // IANA name from the browser, e.g. America/New_York; says when "Friday afternoon" is
  reminder_sent_week String? // the week (e.g. 2026-W42) the last reminder went out, so each week sends once
  // The GitHub account this one signs in with ("Sign in with GitHub"); null for password-only accounts.
  github_id     String?   @unique
  // The Google account ("sub") this one signs in with; null when not linked.
  google_id     String?   @unique
  created_at    DateTime  @default(now())

  clients  Client[]
  projects Project[]
  entries  TimeEntry[]
  invoices Invoice[]
  non_billable_days NonBillableDay[]
  team_members_owned TeamMember[] @relation("TeamOwner")
  team_memberships   TeamMember[] @relation("TeamMemberOf")
  authored_entries   TimeEntry[]  @relation("EntryAuthor")
  invoice_logos InvoiceLogo[]
  email_tokens EmailToken[]
  api_tokens ApiToken[]
  oauth_codes OauthCode[]
  timesheet_shares TimesheetShare[]
  invoice_links InvoiceLink[]
  invoice_emails InvoiceEmail[]

  @@index([is_demo, created_at])
  @@map("auth_users")
}

model Client {
  id         String   @id @default(uuid())
  user_id    String
  name       String
  color      String   @default("#6366f1")
  // Printed in the invoice header's "bill to" block.
  legal_name String?  // full name / company legal name; falls back to `name`
  address    String?  // multi-line
  email      String?  // where invoices are sent; nothing is sent to it unless the freelancer sends something
  logo       String?  // data URL (png/jpeg), resized client-side
  // Billing rounding, applied per entry when an invoice is built (0 = exact minutes). See lib/rounding.ts.
  round_step Int      @default(0)
  round_mode String   @default("up") // "up" | "nearest"
  round_min  Int      @default(0)    // minimum billed minutes per entry (0 = none)
  // ISO 4217; null = the account's currency (lib/money.ts effectiveCurrency). Locked once the client has an invoice.
  currency   String?
  archived   Boolean  @default(false)
  created_at DateTime @default(now())

  user     AuthUser  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  projects Project[]
  team_grants TeamMemberClient[]
  invoices Invoice[]

  @@unique([user_id, name])
  @@map("clients")
}

model Project {
  id          String   @id @default(uuid())
  user_id     String
  client_id   String
  name        String
  hourly_rate Int      @default(0) // cents
  billable    Boolean  @default(true)
  logo        String?  // small data URL (png/jpeg), resized client-side; served via project.logos
  archived    Boolean  @default(false)
  created_at  DateTime @default(now())
  // An optional spending limit: minutes when budget_unit is "hours", cents when "dollars"; null = no budget.
  // budget_period is "month" (resets each calendar month) or "total" (the life of the project).
  budget_amount Int?
  budget_unit   String?
  budget_period String   @default("month")

  user    AuthUser    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  client  Client      @relation(fields: [client_id], references: [id], onDelete: Cascade)
  entries TimeEntry[]

  @@unique([client_id, name])
  @@index([user_id])
  @@map("projects")
}

// Duration is integer minutes. `date` is a local YYYY-MM-DD string so a
// freelancer's "Tuesday" never shifts with UTC offsets. A running timer is a
// row with started_at set (and minutes holding the already-accumulated time).
model TimeEntry {
  id         String    @id @default(uuid())
  user_id    String
  project_id String
  date       String
  minutes    Int       @default(0)
  note       String    @default("")
  started_at DateTime?
  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt

  // Who typed it. null = the account's owner. A team member's entries belong to the OWNER (user_id) and carry the
  // member's id here; if that member's account is deleted the entry stays on the owner's books with author_id null.
  author_id  String?

  // The invoice this time was billed on; null = not invoiced yet (migration 0035). Deleting the invoice frees it.
  invoice_id String?

  user    AuthUser  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  author  AuthUser? @relation("EntryAuthor", fields: [author_id], references: [id], onDelete: SetNull)
  project Project   @relation(fields: [project_id], references: [id], onDelete: Cascade)
  invoice Invoice?  @relation(fields: [invoice_id], references: [id], onDelete: SetNull)

  @@index([author_id])
  @@index([user_id, invoice_id])
  @@index([invoice_id])
  // Both cover the per-project sums (totals, budgets), so they are answered from the index alone, without reading any
  // entry row: all time (by project) and inside a date range (by date). The date one also serves every date-range read.
  @@index([user_id, date, project_id, minutes])
  @@index([user_id, project_id, date, minutes])
  @@index([user_id, started_at])
  // Migration 0024 adds a partial unique index on (user_id) WHERE started_at IS NOT NULL: one running timer per
  // account. Prisma cannot express a partial index, so it lives only in the SQL.
  @@map("time_entries")
}

// A day the account has marked non-billable: its time stays on screen but is left out of invoices, exports and the
// year summary. A row per (account, date); entries added to that date later are covered without touching them.
model NonBillableDay {
  user_id    String
  date       String
  created_at DateTime @default(now())

  user AuthUser @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([user_id, date])
  @@map("non_billable_days")
}

// An issued invoice. `snapshot` is a frozen JSON copy of everything printed on the PDF
// (seller details, lines, per-entry detail), so editing the account, rates or entries later
// never rewrites history; the PDF is regenerated from it on demand. `search_text` is a
// denormalized lowercase blob (number, client, projects, notes) for history search.
model Invoice {
  id            String   @id @default(uuid())
  user_id       String
  client_id     String?
  client_name   String
  number        String
  issue_date    String
  due_date      String?
  // Date the money arrived (YYYY-MM-DD), or null while unpaid. A date, not a flag: cash-basis
  // taxes depend on which year/quarter the payment landed in. Not part of the frozen snapshot.
  paid_date     String?
  period_from   String
  period_to     String
  total_minutes Int
  total_cents   Int
  // The currency the invoice was issued in (also frozen in the snapshot); totals never add two currencies together.
  currency      String   @default("USD")
  notes         String   @default("")
  snapshot      String
  search_text   String
  // One line on what the work was (see lib/invoice-summary.ts); empty = not computed yet.
  summary       String   @default("")
  // Opt-in: remind the client when this invoice is overdue (one day after the due date and again a week after).
  remind_overdue Boolean @default(false)
  reminders_sent Int     @default(0)
  created_at    DateTime @default(now())

  user   AuthUser @relation(fields: [user_id], references: [id], onDelete: Cascade)
  client Client?  @relation(fields: [client_id], references: [id], onDelete: SetNull)
  links  InvoiceLink[]
  emails InvoiceEmail[]
  entries TimeEntry[]

  @@unique([user_id, number])
  @@index([user_id, issue_date])
  @@index([user_id, paid_date])
  @@map("invoices")
}

// A business or client logo as printed on an invoice, stored once per distinct image. Invoice snapshots
// point at it by hash instead of each carrying its own copy (up to 400 KB per logo per invoice).
model InvoiceLogo {
  id         String   @id @default(uuid())
  user_id    String
  hash       String // sha-256 of `data`
  data       String // png/jpeg data URL
  created_at DateTime @default(now())

  user AuthUser @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, hash])
  @@map("invoice_logos")
}

// What changed in time_entries, written by database triggers (migration 0032) so every write path is covered. A
// device remembers the last `seq` it saw (local-first sync, issue #95). Rows say WHICH entry changed, not how.
model EntryChange {
  seq      Int    @id @default(autoincrement())
  user_id  String
  entry_id String
  at       Int    @default(dbgenerated("(unixepoch())"))

  @@index([user_id, seq])
  @@index([at])
  @@map("entry_changes")
}

// Fixed-window counters used to throttle sign-in and register. `reset_at` is epoch seconds.
model RateLimit {
  key      String @id
  count    Int    @default(0)
  reset_at Int

  @@map("rate_limits")
}

// A one-time emailed link. `kind` is "verify" or "reset"; only the SHA-256 of the token is kept.
model EmailToken {
  id         String   @id @default(uuid())
  user_id    String
  kind       String
  token_hash String   @unique
  expires_at Int // epoch seconds
  used_at    Int? // epoch seconds, null until used
  created_at DateTime @default(now())

  user AuthUser @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, kind])
  @@map("email_tokens")
}

// A personal access token for the MCP server (/api/mcp). Only the SHA-256 of the secret is kept,
// so a database leak cannot be turned into working tokens. `prefix` is the first characters of the
// token, shown in the list so people can tell their tokens apart. `access` is "read" or "write".
// `token_version` is the account's value when the token was made: a password change or "Log out on
// all devices" bumps the account's number and so kills every token made before it.
model ApiToken {
  id            String    @id @default(uuid())
  user_id       String
  name          String
  token_hash    String    @unique
  prefix        String
  access        String    @default("write")
  token_version Int       @default(0)
  expires_at    Int? // epoch seconds, null = never
  last_used_at  Int? // epoch seconds
  revoked_at    Int? // epoch seconds, null until revoked
  // The OAuth app this token was made for (null for tokens made by hand); a re-connect replaces by this id.
  oauth_client_id String?
  created_at    DateTime  @default(now())

  user AuthUser @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([user_id, oauth_client_id])
  @@map("api_tokens")
}

/// An MCP client (Claude, Cursor, Smithery...) that registered itself to ask for access through OAuth.
model OauthClient {
  id            String   @id @default(uuid()) // the OAuth client_id
  name          String
  redirect_uris String // JSON array of the exact addresses it may be sent back to
  created_at    DateTime @default(now())

  codes OauthCode[]

  @@map("oauth_clients")
}

/// A one-time authorization code: made when the user approves, traded for an access token within minutes.
model OauthCode {
  id             String  @id @default(uuid())
  code_hash      String  @unique // SHA-256; the code itself is never stored
  client_id      String
  user_id        String
  redirect_uri   String
  code_challenge String // PKCE S256 challenge
  access         String // "read" | "write", chosen on the consent screen
  expires_at     Int // epoch seconds
  used_at        Int? // set when traded (or burned by a failed attempt)
  token_id       String? // the ApiToken it produced, so a replayed code can revoke it
  created_at     DateTime @default(now())

  user   AuthUser    @relation(fields: [user_id], references: [id], onDelete: Cascade)
  client OauthClient @relation(fields: [client_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@map("oauth_codes")
}

// Page views per day, counted with no user id, no cookie and no content (issue #37). `page` is one of
// USAGE_PAGES in lib/usage.ts, so the table cannot grow beyond days x pages.
model UsageDaily {
  day   String
  page  String
  count Int    @default(0)

  @@id([day, page])
  @@map("usage_daily")
}

// Settings for the whole app, set by the owner (see lib/support-notice.ts). Never holds anything about a person.
model AppSetting {
  key        String   @id
  value      String
  updated_at DateTime @default(now())

  @@map("app_settings")
}

// A timesheet a freelancer sends a client for sign-off (issue #34). The link is a random token (only its SHA-256
// is kept); `snapshot` is frozen JSON of the hours, shown without rates or money. Approval is one conditional update.
model TimesheetShare {
  id            String   @id @default(uuid())
  user_id       String
  token_hash    String   @unique
  token_prefix  String
  title         String
  period_from   String
  period_to     String
  snapshot      String
  expires_at    Int
  revoked_at    Int?
  approved_name String?
  approved_note String?
  approved_at   Int?
  created_at    DateTime @default(now())

  user AuthUser @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id, created_at])
  @@map("timesheet_shares")
}

// A private link to one invoice for the client to view and download (issue #35). The token's SHA-256 is all that is kept;
// the page shows the invoice's frozen snapshot, so editing anything later never changes what the client sees.
model InvoiceLink {
  id           String   @id @default(uuid())
  user_id      String
  invoice_id   String
  token_hash   String   @unique
  token_prefix String
  expires_at   Int
  revoked_at   Int?
  created_at   DateTime @default(now())

  user    AuthUser @relation(fields: [user_id], references: [id], onDelete: Cascade)
  invoice Invoice  @relation(fields: [invoice_id], references: [id], onDelete: Cascade)

  @@index([invoice_id])
  @@index([user_id])
  @@map("invoice_links")
}

// An address that must not be mailed: the recipient asked to stop, or it bounced for good. Checked before every client email.
model EmailSuppression {
  email      String   @id
  reason     String
  created_at DateTime @default(now())

  @@map("email_suppressions")
}

// One row per email sent about an invoice (the invoice's history and what the daily limits are checked against).
model InvoiceEmail {
  id         String   @id @default(uuid())
  user_id    String
  invoice_id String
  to_email   String
  kind       String // "invoice" or "reminder"
  created_at DateTime @default(now())

  user    AuthUser @relation(fields: [user_id], references: [id], onDelete: Cascade)
  invoice Invoice  @relation(fields: [invoice_id], references: [id], onDelete: Cascade)

  @@index([invoice_id, created_at])
  @@index([user_id])
  @@map("invoice_emails")
}

// Delegated access (issue #68): the owner invites a person, who signs in with their own account and may log time on the
// clients they were granted. The member never gets the owner's data: every read and write goes through the `member`
// router, which checks this row (accepted, not revoked) and the grant.
model TeamMember {
  id          String   @id @default(uuid())
  owner_id    String
  member_id   String?  // set when the invitation is accepted
  email       String   // the address the invitation went to (lowercase)
  label       String   // what the owner calls this person (their name, or the address when none was given)
  token_hash  String?  @unique // SHA-256 of the invite link; cleared once accepted
  expires_at  Int?     // the invitation's last moment (unix seconds); cleared once accepted
  accepted_at Int?
  revoked_at  Int?
  created_at  DateTime @default(now())

  owner   AuthUser           @relation("TeamOwner", fields: [owner_id], references: [id], onDelete: Cascade)
  member  AuthUser?          @relation("TeamMemberOf", fields: [member_id], references: [id], onDelete: Cascade)
  clients TeamMemberClient[]

  @@index([owner_id])
  @@index([member_id])
  @@map("team_members")
}

model TeamMemberClient {
  team_member_id String
  client_id      String

  team_member TeamMember @relation(fields: [team_member_id], references: [id], onDelete: Cascade)
  client      Client     @relation(fields: [client_id], references: [id], onDelete: Cascade)

  @@id([team_member_id, client_id])
  @@map("team_member_clients")
}
