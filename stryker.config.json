{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.json",
  "mutate": [
    "src/lib/rounding.ts",
    "src/lib/duration.ts",
    "src/lib/invoice.ts",
    "src/lib/rate-limit.ts",
    "src/lib/request-limits.ts",
    "src/lib/oauth.ts",
    "src/lib/api-token.ts",
    "src/lib/timesheet-share.ts",
    "src/lib/social-login.ts",
    "src/lib/quotas.ts",
    "src/lib/client-ip.ts",
    "src/lib/csp.ts",
    "src/lib/email-template.ts",
    "src/lib/safe-next.ts",
    "src/lib/session-version.ts",
    "src/lib/login-throttle.ts",
    "src/lib/reminder.ts",
    "src/lib/merge-entries.ts",
    "src/lib/notes.ts"
  ],
  "coverageAnalysis": "perTest",
  "incremental": true,
  "incrementalFile": ".stryker-tmp/incremental.json",
  "reporters": ["clear-text", "progress", "html"],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "thresholds": {
    "high": 80,
    "low": 65,
    "break": 55
  },
  "ignoreStatic": true,
  "concurrency": 3,
  "ignorePatterns": [
    ".wrangler",
    ".next",
    ".next-e2e",
    ".open-next",
    "e2e",
    "backups",
    "public",
    "reports",
    "node_modules/.cache",
    ".stryker-tmp",
    "bridge",
    "docs",
    ".git"
  ]
}
