{
  // Copy this file to wrangler.jsonc (which is git-ignored) and fill in your own values.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "usehourly",
  // Your Cloudflare account id (Workers & Pages overview, right-hand side). Pinned so a deploy
  // never guesses when your token can see more than one account.
  "account_id": "<your-cloudflare-account-id>",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  // Run the Worker near D1: Prisma's D1 adapter makes several round-trips per query.
  "placement": { "mode": "smart" },
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "d1_databases": [
    // Create it with `npx wrangler d1 create usehourly-db` and paste the database_id it prints.
    { "binding": "DB", "database_name": "usehourly-db", "database_id": "<your-d1-database-id>" }
  ],
  // Optional: your own domain. Cloudflare creates the DNS record and certificate.
  // "routes": [{ "pattern": "app.example.com", "custom_domain": true }],
  "vars": {
    "AUTH_URL": "https://app.example.com",
    "NEXT_PUBLIC_APP_URL": "https://app.example.com"
  },
  "workers_dev": true
}
