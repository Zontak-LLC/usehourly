{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hourly",
  // Pinned: the shared token can see more than one Cloudflare account, and a deploy must never guess.
  "account_id": "251de7ccef88d77aa655572b37af9ea1",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  // Run the Worker near D1: Prisma's D1 adapter makes several round-trips per query.
  "placement": { "mode": "smart" },
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "d1_databases": [
    { "binding": "DB", "database_name": "hourly-db", "database_id": "fd20fd46-8c42-4ee0-8697-118358734897" }
  ],
  // The app's own address. Cloudflare creates the DNS record and certificate for a custom domain.
  "routes": [{ "pattern": "usehourly.app", "custom_domain": true }],
  "vars": {
    "AUTH_URL": "https://usehourly.app",
    "NEXT_PUBLIC_APP_URL": "https://usehourly.app"
  },
  // The old address keeps answering, so existing bookmarks still work.
  "workers_dev": true
}
